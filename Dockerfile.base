FROM nvidia/cuda:12.6.2-cudnn-runtime-ubuntu22.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/root/.cache/huggingface
ENV OLLAMA_HOST=0.0.0.0
ENV OLLAMA_MODELS=/root/.ollama/models

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.10 python3.10-venv python3.10-dev \
    python3-pip \
    ffmpeg libsndfile1 curl zstd \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1

RUN curl -fsSL https://ollama.com/install.sh | sh

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir packaging setuptools wheel
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 \
    --index-url https://download.pytorch.org/whl/cu126
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir stable-audio-tools
RUN pip install --no-cache-dir einops safetensors
RUN pip install --no-cache-dir pytorch_lightning

RUN pip install --no-cache-dir \
    https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.7.16/flash_attn-2.8.3+cu126torch2.7-cp310-cp310-linux_x86_64.whl

ARG HF_TOKEN

RUN python3 -c "from huggingface_hub import login; login(token='${HF_TOKEN}')"

RUN python3 -c "from huggingface_hub import login; login(token='${HF_TOKEN}'); from diffusers import StableAudioPipeline; StableAudioPipeline.from_pretrained('stabilityai/stable-audio-open-1.0'); print('SAO 1.0 cached')"

RUN python3 -c "from huggingface_hub import login, hf_hub_download; login(token='${HF_TOKEN}'); hf_hub_download(repo_id='RoyalCities/Foundation-1', filename='Foundation_1.safetensors'); hf_hub_download(repo_id='RoyalCities/Foundation-1', filename='model_config.json'); print('Foundation-1 cached')"

RUN python3 -c "from huggingface_hub import login, hf_hub_download; login(token='${HF_TOKEN}'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='audialab-edm-elements.safetensors'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='audialab-edm-elements_model_config.json'); print('EDM Elements cached')"

RUN python3 -c "from huggingface_hub import login, hf_hub_download; login(token='${HF_TOKEN}'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='rc-infinite-pianos.safetensors'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='rc-infinite-pianos_model_config.json'); print('Infinite Pianos cached')"

RUN python3 -c "from huggingface_hub import login, hf_hub_download; login(token='${HF_TOKEN}'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='rc-vocal-textures.safetensors'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='rc-vocal-textures_model_config.json'); print('Vocal Textures cached')"

RUN python3 -c "from huggingface_hub import login, hf_hub_download; login(token='${HF_TOKEN}'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='sao-instrumental.safetensors'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='sao-instrumental_model_config.json'); print('SAO Instrumental cached')"

RUN python3 -c "from huggingface_hub import login, hf_hub_download; login(token='${HF_TOKEN}'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='stablebeat.safetensors'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='stablebeat_model_config.json'); print('StableBeat cached')"

RUN python3 -c "from huggingface_hub import login, hf_hub_download; login(token='${HF_TOKEN}'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='gluten-v1.safetensors'); hf_hub_download(repo_id='innermost47/obsidian-neural-models', filename='gluten-v1_model_config.json'); print('Gluten V1 cached')"

RUN python3 -c "from huggingface_hub import login; login(token='${HF_TOKEN}'); from stable_audio_tools import get_pretrained_model; m, c = get_pretrained_model('stabilityai/stable-audio-3-medium'); print('SA3 Medium cached')"

RUN ollama serve & \
    sleep 5 && \
    ollama pull gemma4:e2b && \
    pkill ollama || true